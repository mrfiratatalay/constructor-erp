# Kopyala: cp .env.example .env — sonra istediğini değiştir.
# Bu dosya olmadan da her şey çalışır; aşağıdakiler docker-compose.yml'deki varsayılanların aynısıdır.

# Adresler
WEB_PORT=5173
API_PORT=8080
DB_PORT=5432
# Davet linkleri bu adresle üretilir; WEB_PORT'u değiştirirsen burayı da değiştir.
APP_BASE_URL=http://localhost:5173

# Veritabanı (yalnızca local; production şifresi burada durmaz)
DB_USERNAME=santiye
DB_PASSWORD=santiye

# İlk firma ve patronu: veritabanında hiç firma yokken bir kez oluşturulur (ilk müşteri, "tenant").
COMPANY_NAME=Kızılkan İnşaat
OWNER_NAME=Patron
OWNER_EMAIL=patron@kizilkan.local
OWNER_PASSWORD=patron123

# Platform yönetimi (Constructor ERP ekibi, /platform-admin): firmaları açar, aboneliği ve ödemeleri yönetir.
# Yoksa bir kez oluşturulur; firmaların patronlarından ayrı bir hesaptır.
PLATFORM_ADMIN_NAME=Constructor Destek
PLATFORM_ADMIN_EMAIL=admin@constructor-erp.local
PLATFORM_ADMIN_PASSWORD=admin123

# Tanıtım sitesindeki satış iletişimi (boş bırakılırsa yalnızca başvuru formu görünür).
SALES_PHONE=
SALES_EMAIL=

# http üzerinden çalışırken çerez Secure olamaz. https'e geçince true yap.
SESSION_SECURE_COOKIE=false
