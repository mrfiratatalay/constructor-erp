{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  // routeMeta.d.ts: adreslerin meta tipi (vue-router eklentisi); roles.ts gibi onu kullanan kod testte de derlenir.
  "include": ["src/**/__tests__/*", "env.d.ts", "src/core/navigation/routeMeta.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly. Testler uygulama kodunu içe aktarır: dilin yerleşikleri uygulamayla
    // aynıdır (ES2022, ör. Array.at); DOM tipleri jsdom'dan gelir.
    "lib": ["ES2022"],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
