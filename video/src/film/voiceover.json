  "lines": [
    {"id": "a1", "at": 1.0, "text": "Bir şantiyede gün hiçbir zaman tek yerden başlamaz."},
    {"id": "a2", "at": 4.8, "text": "Mesajlar başka yerde.", "rate": "+6%"},
    {"id": "a3", "at": 6.45, "text": "Yoklama başka yerde.", "rate": "+6%"},
    {"id": "a4", "at": 7.95, "text": "Malzeme başka yerde.", "rate": "+6%"},
    {"id": "a5", "at": 9.45, "text": "Yapılan iş başka yerde.", "rate": "+6%"},
    {"id": "a6", "at": 11.35, "text": "Ve sonunda herkes aynı soruyu sorar:", "rate": "-3%"},
    {"id": "a7", "at": 14.05, "text": "Şu an ne durumdayız?"},
    {"id": "b1", "at": 16.25, "text": "İnşaat zaten karmaşık."},
    {"id": "b2", "at": 18.3, "text": "Yönetimi olmak zorunda değil."},
    {"id": "b3", "at": 21.15, "text": "İskele ERP.", "say": "İskele, erepe."},
    {"id": "c1", "at": 23.4, "text": "Firmanızı anlatın, paketinizi seçin."},
    {"id": "c2", "at": 26.35, "text": "Başvurunuz onaylandığında size özel kurulum bağlantısıyla"},
    {"id": "c3", "at": 30.4, "text": "firma bilgilerinizi, patron hesabınızı ve ilk şantiyenizi birkaç adımda oluşturun."},
    {"id": "d1", "at": 37.9, "text": "Artık her şantiye kendi çalışma alanında."},
    {"id": "d2", "at": 41.3, "text": "Fotoğraflar, videolar, sesli notlar ve günlük saha gelişmeleri ait olduğu yerde kalır."},
    {"id": "e1", "at": 51.0, "text": "Şef yoklamayı sahada alır."},
    {"id": "e2", "at": 55.4, "text": "Ofis aylık puantajı aynı kayıtlardan görür."},
    {"id": "e3", "at": 59.6, "text": "Gerektiğinde Excel'e aktarır.", "say": "Gerektiğinde eksele aktarır."},
    {"id": "f1", "at": 62.9, "text": "Depodan ne çıktı, hangi şantiyeye gitti, ne iade edildi, ne geri bekleniyor…"},
    {"id": "f2", "at": 73.5, "text": "Malzeme hareketleri tek kayıtta."},
    {"id": "g1", "at": 77.0, "text": "İmalatta yapılan işi, kalan işi ve ilerlemeyi görün."},
    {"id": "g2", "at": 83.8, "text": "Taşeronların durumunu tahminle değil, kayıtla takip edin."},
    {"id": "h1", "at": 88.4, "text": "Görevi oluşturun."},
    {"id": "h2", "at": 90.0, "text": "Sorumlusunu ve teslim tarihini belirleyin."},
    {"id": "h3", "at": 92.9, "text": "İşin ne durumda olduğunu tek bakışta görün."},
    {"id": "i1", "at": 95.8, "text": "Saha telefondan günceller."},
    {"id": "i2", "at": 97.95, "text": "Depo hareketi kaydeder."},
    {"id": "i3", "at": 99.8, "text": "Ofis bilgisayardan bütünü takip eder."},
    {"id": "i4", "at": 102.6, "text": "Herkes rolü kadar görür; herkes aynı işin içinde kalır."},
    {"id": "j1", "at": 106.6, "text": "Şantiyeler farklı olabilir. Ekipler farklı olabilir."},
    {"id": "j2", "at": 111.75, "text": "Ama kontrol tek yerde olabilir."},
    {"id": "j3", "at": 114.15, "text": "İskele ERP.", "say": "İskele, erepe."},
    {"id": "j4", "at": 115.95, "text": "Saha hareketli. Kontrol sizde."}
  ]
}
